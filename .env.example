# Local-only demo configuration. These intentionally simple values are not secrets.
# Replace every credential and connection string before any non-local deployment.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port exposed by Docker Compose; change when a native PostgreSQL already uses 5432.
WAREHOUSE_PORT=5432
POSTGRES_DB=c360
POSTGRES_USER=c360
POSTGRES_PASSWORD=c360
WAREHOUSE_DSN=postgresql://c360:c360@localhost:5432/c360
SOURCE_DSN=postgresql://c360:c360@localhost:5433/customer_ops
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
CONNECT_URL=http://localhost:8083
AIRFLOW_UID=50000
ACTIVATION_EXPORT_DIR=reverse_etl/exports
# Local-only demo API key; do not reuse or expose it in a deployed service.
ACTIVATION_API_KEY=local-dev-key
# Docs, ReDoc, and OpenAPI are disabled unless explicitly enabled for local use.
API_ENABLE_DOCS=false
# Deployed keys must be supplied through managed secrets. Example shape only:
# API_PRINCIPALS_JSON={"replace-with-managed-key":{"subject":"tenant-reader","scopes":["customer:read"],"allowed_tenant_ids":["tenant_us"],"global_access":false}}

# --- Snowflake (optional second dbt warehouse target; see snowflake/README.md) ---
# Placeholders only. PostgreSQL above remains the default target (dbt target: dev);
# set DBT_TARGET=snowflake or pass `dbt <cmd> --target snowflake` to use these.
DBT_TARGET=dev
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=dbt_service_user
SNOWFLAKE_PASSWORD=replace-me
SNOWFLAKE_ROLE=C360_TRANSFORMER
SNOWFLAKE_DATABASE=C360
SNOWFLAKE_WAREHOUSE=C360_WH
SNOWFLAKE_SCHEMA=ANALYTICS
